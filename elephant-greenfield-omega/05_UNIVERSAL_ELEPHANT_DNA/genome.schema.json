{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elephant Operational Gene Registry v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "frozen_seed_ref",
    "genes"
  ],
  "properties": {
    "schema": {
      "const": "vomega.elephant.operational-genome.v0.2"
    },
    "version": {
      "type": "string"
    },
    "frozen_seed_ref": {
      "type": "string"
    },
    "classification_policy": {
      "type": "string"
    },
    "genes": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/gene"
      }
    }
  },
  "$defs": {
    "gene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "family",
        "claim",
        "scope_hypothesis",
        "condition",
        "observable_behavior",
        "realization_contract",
        "metrics",
        "fitness",
        "ablation",
        "dependencies",
        "phenotype_mapping",
        "status",
        "open_question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DNA-[0-9]{2}$"
        },
        "name": {
          "type": "string"
        },
        "family": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "claim": {
          "type": "string"
        },
        "scope_hypothesis": {
          "enum": [
            "UNIVERSAL_CANDIDATE",
            "TOPOLOGY_CONDITIONAL",
            "PHENOTYPE_CANDIDATE",
            "ENVIRONMENTAL_SUPPORT_CANDIDATE",
            "REALIZATION_CANDIDATE",
            "MERGE_CANDIDATE"
          ]
        },
        "condition": {
          "type": "string"
        },
        "observable_behavior": {
          "type": "string"
        },
        "realization_contract": {
          "type": "object",
          "required": [
            "inputs",
            "outputs",
            "events"
          ],
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fitness": {
          "type": "object",
          "required": [
            "probe_id",
            "threshold",
            "execution_status",
            "fixture_ref"
          ],
          "properties": {
            "probe_id": {
              "type": "string"
            },
            "threshold": {
              "type": "string"
            },
            "execution_status": {
              "enum": [
                "NOT_RUN",
                "HARNESS_ONLY",
                "ACTUAL_SCOPED",
                "CROSS_DOMAIN_VALIDATED"
              ]
            },
            "fixture_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ablation": {
          "type": "object",
          "required": [
            "intervention",
            "expected_failure",
            "restoration"
          ],
          "properties": {
            "intervention": {
              "type": "string"
            },
            "expected_failure": {
              "type": "string"
            },
            "restoration": {
              "type": "string"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phenotype_mapping": {
          "type": "object",
          "required": [
            "product",
            "harvest",
            "research"
          ],
          "properties": {
            "product": {
              "enum": [
                "APPLIES",
                "CONDITIONAL",
                "UNKNOWN",
                "NOT_REQUIRED"
              ]
            },
            "harvest": {
              "enum": [
                "APPLIES",
                "CONDITIONAL",
                "UNKNOWN",
                "NOT_REQUIRED"
              ]
            },
            "research": {
              "enum": [
                "APPLIES",
                "CONDITIONAL",
                "UNKNOWN",
                "NOT_REQUIRED"
              ]
            }
          }
        },
        "status": {
          "enum": [
            "CANDIDATE",
            "PROBED",
            "VERIFIED_IN_SCOPE",
            "VALIDATED_CROSS_DOMAIN",
            "MERGED",
            "DEMOTED",
            "DELETED"
          ]
        },
        "open_question": {
          "type": "string"
        }
      }
    }
  }
}
