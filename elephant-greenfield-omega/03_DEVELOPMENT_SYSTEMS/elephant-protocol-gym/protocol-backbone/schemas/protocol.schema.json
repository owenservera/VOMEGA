{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vomega.local/schemas/epg-protocol-0.1.schema.json",
  "title": "EPG Protocol Card: composable research/execution contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "state",
    "kind",
    "title",
    "authority",
    "sources",
    "purpose",
    "interfaces",
    "conditions",
    "phases",
    "gates",
    "outputs",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "epg.protocol/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]+$"
    },
    "version": {
      "type": "string"
    },
    "state": {
      "enum": [
        "PROPOSED",
        "APPROVED_DIRECTION",
        "FROZEN",
        "EXPERIMENTAL",
        "VERIFIED_MECHANICS",
        "RETIRED"
      ]
    },
    "kind": {
      "enum": [
        "experiment",
        "executor",
        "evaluator",
        "task",
        "economy",
        "publication",
        "semantic",
        "visual",
        "governance",
        "feeder",
        "composition"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "authority": {
      "enum": [
        "research_only",
        "owner_direction",
        "owner_approved_experiment",
        "operator_authorized_execution"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 12
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "compatibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preconditions",
        "forbidden"
      ],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readiness": {
          "enum": [
            "READY_TO_ATTEMPT",
            "BLOCKED",
            "DESIGN_ONLY",
            "NEEDS_CENSUS"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "completion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "completion": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "on_failure": {
            "type": "string"
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_status",
        "claims",
        "limitations"
      ],
      "properties": {
        "mapping_status": {
          "enum": [
            "FULL_SOURCE_BOUND",
            "PARTIAL_MAPPING",
            "EXCERPT_ONLY"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "falsifier"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "falsifier": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced optional typed modules, e.g. epg.time_credit, epg.isolation. Runtime validates referenced module schema. Never assume unknown extension is authorized."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "status"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "status": {
            "enum": [
              "OPEN",
              "OWNER_APPROVED",
              "EXPERIMENTAL",
              "REJECTED"
            ]
          },
          "answer": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "role",
        "evidence"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "role": {
          "enum": [
            "authority",
            "candidate",
            "historical",
            "code",
            "test",
            "artifact",
            "owner_input"
          ]
        },
        "evidence": {
          "enum": [
            "SOURCE_INSPECTED",
            "AUTHOR_REPORTED",
            "LOCAL_REPRODUCED",
            "HOST_OBSERVED",
            "DESIGN_ONLY",
            "UNAVAILABLE"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "when_unknown",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "when_unknown": {
          "enum": [
            "BLOCK",
            "UNKNOWN",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "oracle_ref": {
          "type": "string"
        },
        "witness": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PROPOSED",
            "NOT_RUN",
            "VERIFIED"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "evidence_source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "evidence_source": {
          "enum": [
            "HOST",
            "PROVIDER",
            "REFEREE",
            "SELF_REPORT",
            "DERIVED",
            "UNKNOWN"
          ]
        },
        "aggregation": {
          "type": "string"
        },
        "missing": {
          "enum": [
            "UNKNOWN",
            "NOT_APPLICABLE",
            "INVALID"
          ]
        }
      }
    }
  }
}
