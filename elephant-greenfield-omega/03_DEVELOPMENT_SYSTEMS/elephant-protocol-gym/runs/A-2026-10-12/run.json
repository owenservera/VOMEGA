  "claims": [
    {
      "statement": "repeat() does not enforce its declared 'count is a nonnegative safe integer' precondition: -1, NaN, 2.5, 0.5 and 3.7 are all silently accepted and none throws.",
      "evidence_class": "MEASURED",
      "witness_provenance": "INDEPENDENTLY_REPRODUCED",
      "witness_refs": [
        "runs/A-2026-10-12/exp1-results.json",
        "runs/REVIEWER-R1-2026-10-12/reviewer-witness-output.json"
      ]
    },
    {
      "statement": "classify(NaN) returns 'positive', which is inside the declared union yet outside common sense.",
      "evidence_class": "MEASURED",
      "witness_provenance": "INDEPENDENTLY_REPRODUCED",
      "witness_refs": [
        "runs/A-2026-10-12/exp4-results.json",
        "runs/REVIEWER-R1-2026-10-12/reviewer-witness-output.json"
      ]
    },
    {
      "statement": "Mutating add()'s BODY (a+b to a*b) leaves the emitted .d.ts byte-identical, so the type surface cannot see a semantic-only change; mutating the signature does change it.",
      "evidence_class": "MEASURED",
      "witness_provenance": "INDEPENDENTLY_REPRODUCED",
      "witness_refs": [
        "runs/A-2026-10-12/exp2-results.json",
        "runs/REVIEWER-R1-2026-10-12/dts-mutation-check.mjs"
      ]
    },
    {
      "statement": "repeat() is not atomic: a throwing callback leaves values already delivered with no rollback.",
      "evidence_class": "MEASURED",
      "witness_provenance": "INDEPENDENTLY_REPRODUCED",
      "witness_refs": [
        "runs/A-2026-10-12/exp5-results.json"
      ]
    },
    {
      "statement": "MAX_RETRIES carries the fixture's most rigid type (literal 3) and is referenced nowhere else in the file (1 textual occurrence: its own declaration).",
      "evidence_class": "MEASURED",
      "witness_provenance": "INDEPENDENTLY_REPRODUCED",
      "witness_refs": [
        "runs/A-2026-10-12/facts-baseline.json"
      ]
    },
    {
      "statement": "Placement matters: a plain comment channel failed to detect the body mutation, while a generated sidecar did.",
      "evidence_class": "MEASURED",
      "witness_provenance": "SELF_WITNESSED",
      "witness_refs": [
        "runs/A-2026-10-12/exp3-results.json"
      ]
    },
    {
      "statement": "All five experiment claims re-derive from execution via verify-run-note.mjs (exit 0).",
      "evidence_class": "MEASURED",
      "witness_provenance": "SELF_WITNESSED",
      "witness_refs": [
        "runs/A-2026-10-12/verify-run-note.mjs"
      ]
    },
    {
      "statement": "The run's descriptive verbosity transfers to other source. Nothing here measures real-code recall, cost or safety.",
      "evidence_class": "DESIGN"
    }
