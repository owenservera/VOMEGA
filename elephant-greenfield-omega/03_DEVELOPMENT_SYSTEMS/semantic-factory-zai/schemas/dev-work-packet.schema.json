{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narrow Product Elephant Developer Work Packet v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "ratchet_link": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_elephant_id": {
      "type": "string"
    },
    "product_model_revision": {
      "type": "string"
    },
    "product_base_sha": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "required_behavior": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "effects_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lease_id": {
      "type": "string"
    },
    "escalation_channel": {
      "type": "string"
    },
    "completion_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ASSIGNED",
        "BLOCKED",
        "SUBMITTED",
        "REJECTED",
        "INTEGRATED"
      ]
    }
  },
  "required": [
    "packet_id",
    "round",
    "product_elephant_id",
    "product_model_revision",
    "product_base_sha",
    "goal",
    "required_behavior",
    "allowed_paths",
    "forbidden_paths",
    "allowed_symbols",
    "non_goals",
    "test_commands",
    "effects_allowed",
    "lease_id",
    "escalation_channel",
    "completion_fields",
    "current_status"
  ]
}
