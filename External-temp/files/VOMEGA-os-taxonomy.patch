+        "doc": "Check a drive for errors (read-only) — capability maintenance.disk.check (observe). Payload {params?, dryRun?}; params: drive?:string."
+      },
+      {
+        "kind": "contract",
+        "id": "os.x.maintenance.memory.test",
+        "version": "1",
+        "risk": "EXTERNAL_MUTATION",
+        "doc": "Test memory (RAM) — capability maintenance.memory.test (session-end, consent). Payload {params?, dryRun?}; params: none."
+      }
+    ]
+  },
+  "dependencies": [],
+  "capabilities": {
+    "requested": [
+      "port:vault.append@1"
+    ],
+    "justification": "Attempt/outcome ledger rows for non-READ capability executions persist in the USER'S VAULT (ns 'os') via port:vault.append@1 — written before any OS effect so an interrupted action is reconstructable. Rows carry parameter names and digests, not raw values. Process creation rides @vivim/omega-platform's platformSpawn (the sole OS seam)."
+  },
+  "runtime": {
